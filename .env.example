GITHUB_TOKEN=
# Local PostgreSQL, e.g. postgresql://postgres:password@localhost:5432/repocompass
# Neon refuses connections without SSL; append ?sslmode=require
# e.g. postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=
# Optional, for the integration tests only: a separate, empty database.
# TEST_DATABASE_URL=
# Optional. Where repositories are cloned. A relative path is relative to the folder the
# command is run from, so run commands from the project root (default: data/repos).
# REPOCOMPASS_CLONE_DIR=data/repos
# Optional. Browser origins allowed to call the API (comma-separated; '*' is refused).
# Set this if the web pages run on another port (default: localhost and 127.0.0.1 on port 3000).
# REPOCOMPASS_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The web pages read NEXT_PUBLIC_API_URL (default http://127.0.0.1:8000); set it in web/.env.local
# if the API runs on another port.
