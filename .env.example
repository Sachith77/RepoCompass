GITHUB_TOKEN=
# Neon refuses connections without SSL; append ?sslmode=require
# e.g. postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=
# Optional. Where repositories are cloned. A relative path is relative to the folder the
# command is run from, so run commands from the project root (default: data/repos).
# REPOCOMPASS_CLONE_DIR=data/repos
